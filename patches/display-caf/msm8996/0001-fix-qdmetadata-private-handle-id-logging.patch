From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 30 Jun 2026 20:50:00 +0800
Subject: [PATCH] msm8996: drop private_handle_t id logging

LineageOS 15.1 trees can pair this CAF display stack with a gralloc
private_handle_t definition that has no id member. The failing references
are only used in error logging, so remove them instead of guessing a
replacement field.
---
 msm8996/libqdutils/qdMetaData.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/msm8996/libqdutils/qdMetaData.cpp b/msm8996/libqdutils/qdMetaData.cpp
index 13e61bb..97026d4 100644
--- a/msm8996/libqdutils/qdMetaData.cpp
+++ b/msm8996/libqdutils/qdMetaData.cpp
@@ -38,12 +38,12 @@ int validateAndMap(private_handle_t *handle)
 {
    if (NULL == handle) {
-        ALOGE("%s: Invalid handle %p id %d",
-                __func__, handle, handle->id);
+        ALOGE("%s: Invalid handle %p",
+                __func__, handle);
         return -1;
     }
     if (handle->fd_metadata == -1) {
-        ALOGE("%s: metadata not mapped for handle %p id %d fd %d",
-                __func__, handle, handle->id, handle->fd_metadata);
+        ALOGE("%s: metadata not mapped for handle %p fd %d",
+                __func__, handle, handle->fd_metadata);
         return -1;
     }
     size_t size = ROUND_UP_PAGESIZE(sizeof(MetaData_t));
@@ -53,7 +53,7 @@ int validateAndMap(private_handle_t *handle)
                     0, handle->fd_metadata, 0);
     if (metadata == MAP_FAILED) {
-        ALOGE("%s: failed to map metadata for handle %p id %d fd %d err %s",
-                __func__, handle, handle->id, handle->fd_metadata, strerror(errno));
+        ALOGE("%s: failed to map metadata for handle %p fd %d err %s",
+                __func__, handle, handle->fd_metadata, strerror(errno));
         return -1;
     }
     handle->base_metadata = uint64_t(metadata);
-- 
