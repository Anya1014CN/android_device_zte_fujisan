<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
     Android's local-display policy reads this vendor file before the mutable
     /data override.  HWC exposes a stable wrapper-owned Wide endpoint as
     local:1; DeviceState selects it as the default only while unfolded.
-->
<display-settings>
    <config identifier="0" />
    <display name="local:1" shouldShowSystemDecors="true" shouldShowIme="true" />
</display-settings>
