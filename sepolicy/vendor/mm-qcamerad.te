# The legacy camera daemon shares camera metadata with the framework.
# Keep the compatibility declaration and socket rules used by msm8996-common.
typeattribute mm-qcamerad data_between_core_and_vendor_violators;

get_prop(mm-qcamerad, fujisan_camera_gyro_prop)

allow mm-qcamerad camera_data_file:dir search;
allow mm-qcamerad camera_data_file:file rw_file_perms;
allow mm-qcamerad camera_data_file:sock_file { create unlink };
