type fujisan_wcnss_filter, domain;
type fujisan_wcnss_filter_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(fujisan_wcnss_filter)

r_dir_file(fujisan_wcnss_filter, vendor_file)
get_prop(fujisan_wcnss_filter, bluetooth_prop)
set_prop(fujisan_wcnss_filter, vendor_bluetooth_prop)
wakelock_use(fujisan_wcnss_filter)

# wcnss_filter configures the Bluetooth transport over the Qualcomm UART.
allow fujisan_wcnss_filter serial_device:chr_file rw_file_perms;
