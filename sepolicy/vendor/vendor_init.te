typeattribute vendor_init data_between_core_and_vendor_violators;
set_prop(vendor_init, fujisan_camera_gyro_prop)

# Legacy vendor rc initializes these framework-owned and Qualcomm data dirs.
allow vendor_init {
  camera_data_file
  media_userdir_file
  system_data_file
  wifi_data_file
  wpa_socket
  dhcp_data_file
  tombstone_data_file
}:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };
