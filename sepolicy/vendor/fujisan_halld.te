type fujisan_halld, domain;
# The panel-control socket accepts requests from dedicated app domains that
# carry per-app MLS categories. Mark only this narrow IPC server as trusted,
# satisfying the unix_stream_socket connectto MLS constraint without granting
# the app domain global MLS override privileges.
typeattribute fujisan_halld mlstrustedsubject;
type fujisan_halld_exec, exec_type, vendor_file_type, file_type;
type fujisan_halld_socket, file_type;
# This socket is the narrow IPC endpoint used by the two dedicated panel
# control apps. Mark only the socket object MLS-trusted so app categories can
# connect without making the application domain globally trusted.
typeattribute fujisan_halld_socket mlstrustedobject;

init_daemon_domain(fujisan_halld)

allow fujisan_halld graphics_device:chr_file rw_file_perms;
allow fujisan_halld input_device:dir search;
allow fujisan_halld input_device:chr_file r_file_perms;
allow fujisan_halld sysfs_graphics:dir search;
allow fujisan_halld sysfs_graphics:file rw_file_perms;
allow fujisan_halld sysfs_leds:dir search;
allow fujisan_halld sysfs_leds:file rw_file_perms;
allow fujisan_halld sysfs:dir r_dir_perms;
allow fujisan_halld sysfs:file rw_file_perms;
allow fujisan_halld sysfs_devices_system_cpu:file rw_file_perms;
allow fujisan_halld self:unix_stream_socket { accept create getopt listen read setopt write };
get_prop(fujisan_halld, boot_status_prop)
set_prop(fujisan_halld, fujisan_display_prop)
get_prop(fujisan_halld, fujisan_display_prop)
