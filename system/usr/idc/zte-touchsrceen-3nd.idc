# Combined expanded input (2160x1920).  It owns all physical touch slots so
# gestures spanning both panels retain their pointer identities.  Wide is the
# active internal endpoint in OPEN state (local:1); Small/local:0 is disabled
# by display_layout_configuration.xml during the same transition.
device.internal = 1
touch.deviceType = touchScreen
touch.orientationAware = 1
touch.displayId = local:1
