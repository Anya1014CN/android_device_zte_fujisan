# Android 16 first-stage fstab used from the boot ramdisk.
# Fujisan is non-Treble and has no separate vendor partition.
# Mount system for second-stage handoff, plus dcmlog/cache for early breadcrumb logs.

/dev/block/platform/soc/7464900.sdhci/by-name/system        /system  ext4  ro,barrier=1,discard                    wait,first_stage_mount
/dev/block/platform/soc/7464900.sdhci/by-name/dcmlog        /dcmlog  ext4  rw,noatime,nosuid,nodev,barrier=1       wait,check,formattable,first_stage_mount
/dev/block/platform/soc/7464900.sdhci/by-name/cache         /cache   ext4  rw,noatime,nosuid,nodev,barrier=1       wait,formattable,first_stage_mount
