# This alphabetic rc name is parsed before bpfloader.rc. Define the service
# first so AOSP's load_bpf_programs action runs the safe 3.18 stub.
service bpfloader /system/bin/fujisan_bpfloader
    class core
    user root
    group root system
    oneshot

on early-init
    setprop bpf.progs_loaded 1
