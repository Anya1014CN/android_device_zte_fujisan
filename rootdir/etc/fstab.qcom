# Android second-stage / recovery fstab for fujisan.
# First-stage init mounts system from the boot ramdisk fstab. Keep a /system
# entry here for OTA packaging and recovery tools; do not add verify/avb.

#<src>                                                  <mnt_point>       <type>  <mnt_flags and options>                                          <fs_mgr_flags>
/dev/block/platform/soc/7464900.sdhci/by-name/system    /system           ext4    ro,barrier=1,discard                                             wait
/dev/block/platform/soc/7464900.sdhci/by-name/boot      /boot             emmc    defaults                                                         defaults
/dev/block/platform/soc/7464900.sdhci/by-name/recovery  /recovery         emmc    defaults                                                         defaults
/dev/block/platform/soc/7464900.sdhci/by-name/cache     /cache            ext4    noatime,nosuid,nodev,barrier=1                                   wait,formattable,check
/dev/block/platform/soc/7464900.sdhci/by-name/persist   /persist          ext4    noatime,nosuid,nodev,barrier=1                                   wait,check,formattable
/dev/block/platform/soc/7464900.sdhci/by-name/userdata  /data             f2fs    noatime,nosuid,nodev,discard,resuid=1000,resgid=1000             latemount,wait,formattable,check,reservedsize=104857600,encryptable=footer,quota
/devices/soc/74a4900.sdhci/mmc_host*                    /storage/sdcard1  vfat    nosuid,nodev                                                     wait,voldmanaged=sdcard1:auto,encryptable=footer
/dev/block/platform/soc/7464900.sdhci/by-name/misc      /misc             emmc    defaults                                                         defaults
/dev/block/platform/soc/7464900.sdhci/by-name/dsp       /dsp              ext4    ro,nosuid,nodev,barrier=1                                        wait
/dev/block/platform/soc/7464900.sdhci/by-name/modem     /firmware         vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0  wait
/dev/block/platform/soc/7464900.sdhci/by-name/bluetooth /bt_firmware      vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0  wait
/devices/soc/6a00000.ssusb/6a00000.dwc3/xhci-hcd.0.auto/usb* auto          auto    nosuid,nodev                                                     wait,voldmanaged=usb:auto
