service fujisan_halld /vendor/bin/fujisan_halld
    class late_start
    user system
    group system graphics input
    disabled

# Panel posture must be available before SystemServer finishes boot; waiting for
# sys.boot_completed keeps B dark for roughly 30 seconds after every reboot.
on early-boot
    start fujisan_halld

# fujisan_halld blocks on the m1120 input event in steady state.  These are
# the non-hinge transitions which must force one immediate reconciliation.
on property:sys.boot_completed=1
    restart fujisan_halld

on property:vendor.fujisan.display_power=0
    restart fujisan_halld

on property:vendor.fujisan.display_power=1
    restart fujisan_halld

on property:persist.vendor.fujisan.user_mode=dual
    # On this legacy MDSS stack a primary mode change does not cause
    # SurfaceFlinger to recreate its wide client target.  Keeping it alive
    # leaves fb1 with a stale crop/stride (garbled B) and retains the old
    # mobile Configuration.  Recreate the compositor transactionally so both
    # display topology and app resources are regenerated from the new mode.
    restart vendor.hwcomposer-2-4
    restart surfaceflinger
    restart fujisan_halld

on property:persist.vendor.fujisan.user_mode=zoom
    restart vendor.hwcomposer-2-4
    restart surfaceflinger
    restart fujisan_halld
