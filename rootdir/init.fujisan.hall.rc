service fujisan_halld /vendor/bin/fujisan_halld
    class late_start
    user root
    group root system graphics input
    disabled

# Publish the topology property before SurfaceFlinger registers HWC callbacks.
# The HWC watcher then always has a property serial to sleep on during the
# early-boot window, rather than waiting for the first user input.
on early-init
    setprop vendor.fujisan.display_mode single
    setprop vendor.fujisan.systemui_geometry single

# SystemUI caches its status-bar geometry by physical-display ID.  The virtual
# A+B topology keeps that ID, so after an unfold the cache must be rebuilt.
# Run this separate one-shot as root so the SystemUI process receives a
# normal signal rather than a direct in-process binder call.
service fujisan_systemui_refresh /system/bin/sh -c "/system/bin/killall -TERM com.android.systemui; /system/bin/setprop vendor.fujisan.systemui_refresh 0"
    class late_start
    user root
    group root
    disabled
    oneshot

# Start early solely to publish the stable A-only boot topology.  The daemon
# itself defers all expanded-panel work until init restarts it at boot complete.
on early-boot
    start fujisan_halld

on boot
    write /sys/module/zte_touch_expand/parameters/separate_inputs Y

# fujisan_halld blocks on the m1120 input event in steady state.  These are
# the non-hinge transitions which must force one immediate reconciliation.
on property:sys.boot_completed=1
    restart fujisan_halld

on property:vendor.fujisan.display_power=0
    restart fujisan_halld

on property:vendor.fujisan.display_power=1
    restart fujisan_halld

# The hall daemon publishes the physical posture on every hinge event.  Keep
# the kernel touch topology in lockstep without polling from userspace.
on property:vendor.fujisan.hall_status=1
    write /sys/module/zte_touch_expand/parameters/separate_inputs Y

on property:vendor.fujisan.hall_status=2
    write /sys/module/zte_touch_expand/parameters/separate_inputs N

on property:vendor.fujisan.hall_status=3
    write /sys/module/zte_touch_expand/parameters/separate_inputs N

on property:vendor.fujisan.systemui_refresh=1
    start fujisan_systemui_refresh
