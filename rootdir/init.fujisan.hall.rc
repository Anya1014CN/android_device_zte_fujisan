service fujisan_halld /vendor/bin/fujisan_halld
    class late_start
    user root
    group root system graphics input
    socket fujisan_primary stream 0666 root root
    disabled

# Publish the topology property before SurfaceFlinger registers HWC callbacks.
# The HWC watcher then always has a property serial to sleep on during the
# early-boot window, rather than waiting for the first user input.
on early-init
    setprop vendor.fujisan.display_mode single

# Start early solely to publish the stable A-only boot topology.  The daemon
# itself defers all expanded-panel work until init restarts it at boot complete.
on early-boot
    start fujisan_halld

on boot
    write /sys/module/zte_touch_expand/parameters/separate_inputs Y

    # QPNP creates blink after the LED class device, too late for ueventd.
    # The stock HIDL Light HAL runs as system.
    chown system system /sys/class/leds/red/blink
    chmod 0664 /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/blink
    chmod 0664 /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/blink
    chmod 0664 /sys/class/leds/blue/blink

# fujisan_halld blocks on the m1120 input event in steady state.  Only boot
# completion needs a reconciliation; mdss_fb owns both panels' backlight and
# DCS transitions during display power changes.
on property:sys.boot_completed=1
    restart fujisan_halld

# The hall daemon publishes the physical posture on every hinge event.  Keep
# the kernel touch topology in lockstep without polling from userspace.
on property:vendor.fujisan.hall_status=1
    write /sys/module/zte_touch_expand/parameters/separate_inputs Y

on property:vendor.fujisan.hall_status=2
    write /sys/module/zte_touch_expand/parameters/separate_inputs N

on property:vendor.fujisan.hall_status=3
    write /sys/module/zte_touch_expand/parameters/separate_inputs N
