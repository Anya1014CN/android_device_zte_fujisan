service fujisan_halld /vendor/bin/fujisan_halld
    class late_start
    user root
    group root system graphics input
    socket fujisan_primary stream 0666 root root
    disabled

# Publish the topology property before SurfaceFlinger registers HWC callbacks.
# The HWC watcher then always has a property serial to sleep on during the
# early-boot window, rather than waiting for the first user input.
on early-init
    setprop vendor.fujisan.display_mode single

# Persistent properties are replayed after /data is available.  Mirror the
# selected folded primary immediately so an A/B preference made in the prior
# session is visible before BootAnimation's first client target.  This only
# selects the physical single-panel route; display_mode remains single until
# fujisan_halld applies the actual hinge posture after boot completion.
on property:persist.vendor.fujisan.primary_panel=a
    setprop vendor.fujisan.active_primary a

on property:persist.vendor.fujisan.primary_force=0
    setprop vendor.fujisan.active_primary a

on property:persist.vendor.fujisan.primary_panel=b && property:persist.vendor.fujisan.primary_force=1
    setprop vendor.fujisan.active_primary b

# Start early solely to publish the stable single-panel boot topology.  The
# persisted A/B primary choice may select either physical panel; expanded work
# remains deferred until init restarts the daemon at boot completion.
on early-boot
    start fujisan_halld

on boot
    # QPNP creates blink after the LED class device, too late for ueventd.
    # The stock HIDL Light HAL runs as system.
    chown system system /sys/class/leds/red/blink
    chmod 0664 /sys/class/leds/red/blink
    chown system system /sys/class/leds/green/blink
    chmod 0664 /sys/class/leds/green/blink
    chown system system /sys/class/leds/blue/blink
    chmod 0664 /sys/class/leds/blue/blink

# fujisan_halld blocks on the m1120 input event in steady state.  Only boot
# completion needs a reconciliation; mdss_fb owns both panels' backlight and
# DCS transitions during display power changes.
on property:sys.boot_completed=1
    restart fujisan_halld
