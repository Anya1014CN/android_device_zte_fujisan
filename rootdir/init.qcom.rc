import /init.dualscreen.rc

on early-init
    mkdir /firmware 0771 system system
    mkdir /bt_firmware 0771 system system
    mkdir /dsp 0771 media media
    mkdir /persist 0771 system system
    rmdir /vendor
    symlink /system/vendor /vendor
    symlink /sys/kernel/debug /d

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mount ext4 /dev/block/bootdevice/by-name/cache /cache noatime nosuid nodev barrier=1
    write /cache/fujisan-init-stage fs-enter
    mount_all /system/vendor/etc/fstab.qcom
    swapon_all /system/vendor/etc/fstab.qcom
    write /cache/fujisan-init-stage fs
    restorecon_recursive /persist

on boot
    write /cache/fujisan-init-stage boot
    # Keep the PM8994 NFC/eSE power request line in a defined state before
    # the NFC HAL starts probing the PN548 over I2C.
    write /sys/class/gpio/export 1015
    write /sys/class/gpio/gpio1015/direction out
    write /sys/class/gpio/gpio1015/value 1
