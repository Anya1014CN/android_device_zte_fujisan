on early-init
    write /dev/pmsg0 "fujisan:init.qcom early-init\n"

on init
    write /dev/pmsg0 "fujisan:init.qcom init\n"

on fs
    write /dev/pmsg0 "fujisan:init.qcom fs-enter\n"
    mkdir /cache 0770 system cache
    mount ext4 /dev/block/platform/soc/7464900.sdhci/by-name/cache /cache noatime nosuid nodev barrier=1
    write /cache/fujisan-init-stage fs-enter
    mount_all /system/vendor/etc/fstab.qcom
    swapon_all /system/vendor/etc/fstab.qcom
    write /cache/fujisan-init-stage fs
    write /dev/pmsg0 "fujisan:init.qcom fs-done\n"
    restorecon_recursive /persist

on boot
    write /dev/pmsg0 "fujisan:init.qcom boot\n"
    write /cache/fujisan-init-stage boot
    # Keep the PM8994 NFC/eSE power request line in a defined state before
    # the NFC HAL starts probing the PN548 over I2C.
    write /sys/class/gpio/export 1015
    write /sys/class/gpio/gpio1015/direction out
    write /sys/class/gpio/gpio1015/value 1
