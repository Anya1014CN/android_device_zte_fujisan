on fs
    mount_all /vendor/etc/fstab.qcom --early

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

on post-fs
    restorecon_recursive /persist
    insmod /lib/modules/wlan.ko
    setprop wlan.driver.status ok

# This kernel uses the legacy android_usb gadget rather than configfs.  Map
# Android's "adb" composition name to FunctionFS before init.usb.rc applies
# the persistent USB configuration.
on init
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb

on boot
    write /dev/kmsg "fujisan:boot\n"
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    # Lineage exposes the panels as independent displays.
    write /sys/module/zte_touch_expand/parameters/separate_inputs 1
    # Keep the PM8994 NFC/eSE power request line in a defined state before
    # the NFC HAL starts probing the PN548 over I2C.
    write /sys/class/gpio/export 1015
    write /sys/class/gpio/gpio1015/direction out
    write /sys/class/gpio/gpio1015/value 1
