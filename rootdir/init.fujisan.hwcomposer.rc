# This vendor rc is imported after android.hardware.graphics.composer@2.4-service.rc
# (android.* sorts before init.*).  Keep the service override with the vendor
# binary it configures; early GPU/gralloc setup is in system init.qcom.rc.
service vendor.hwcomposer-2-4 /vendor/bin/hw/fujisan-composer-service
    override
    # IComposer@2.4 extends the 2.1, 2.2 and 2.3 HIDL interfaces.  init's
    # host verifier requires the complete inheritance chain on this service.
    interface android.hardware.graphics.composer@2.1::IComposer default
    interface android.hardware.graphics.composer@2.2::IComposer default
    interface android.hardware.graphics.composer@2.3::IComposer default
    interface android.hardware.graphics.composer@2.4::IComposer default
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    setenv LD_PRELOAD /vendor/lib64/libhidlbase_fujisan_legacy_map_shim.so
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow

# The stock vendor image imports a 2.1 declaration.  Keep it disabled so only
# the VINTF-declared Composer 2.4 service registers the default instance.
service hwcomposer-2-1 /vendor/bin/hw/android.hardware.graphics.composer@2.1-service
    override
    disabled
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    task_profiles ServiceCapacityLow
