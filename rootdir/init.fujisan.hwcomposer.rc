# AOSP installs vendor.hwcomposer-2-4 via
# android.hardware.graphics.composer@2.4-service. Keep only early GPU/ION
# node permissions required by SurfaceFlinger/Adreno on this legacy kernel.
# Wide C consumes a linear client target.  These are read by CAF gralloc
# before it creates SurfaceFlinger's framebuffer pool.
on early-boot
    chmod 0666 /dev/kgsl-3d0
    chown system system /dev/kgsl-3d0
    chmod 0664 /dev/ion
    chown system system /dev/ion
    setprop vendor.gralloc.disable_ubwc 1
    setprop vendor.gralloc.enable_fb_ubwc 0

on boot
    setprop vendor.gralloc.disable_ubwc 1
    setprop vendor.gralloc.enable_fb_ubwc 0
