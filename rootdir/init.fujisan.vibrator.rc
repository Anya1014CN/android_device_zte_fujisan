# Software vibrator shim: no haptic driver on this kernel build.
service fujisan-vibrator-shim /system/bin/fujisan_vibrator
    class core
    user root
    group root system
    oneshot
    disabled

on early-boot
    start fujisan-vibrator-shim

on property:init.svc.hwservicemanager=running
    start fujisan-vibrator-shim
    start vibrator-1-0
