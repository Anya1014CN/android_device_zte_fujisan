# Android 16's mainline bpfloader requires a 5.10 kernel. Fujisan's 4.4
# kernel supplies only four no-match socket filters needed by legacy netd;
# it deliberately does not load the mainline BPF program set.
service bpfloader /system/bin/netd_bpf_compat
    override
    capabilities CHOWN SYS_ADMIN NET_ADMIN SYSLOG
    group root graphics network_stack net_admin net_bw_acct net_bw_stats net_raw system
    user root
    rlimit memlock 1073741824 1073741824
    oneshot
