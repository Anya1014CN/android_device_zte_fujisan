# The standard android.hardware.usb service owns all gadget functions.  This
# device fragment only provides the msm8996 configfs/controller prerequisites.

on early-init
    setprop sys.usb.configfs 1

on init
    chmod 0771 /dev/usb-ffs
    mount configfs none /config
    mkdir /config/usb_gadget/g1
    setprop sys.usb.configfs 1

on post-fs
    setprop sys.usb.configfs 1
    write /sys/devices/soc/6a00000.ssusb/mode peripheral

on boot
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 6a00000.dwc3
    write /sys/devices/soc/6a00000.ssusb/mode peripheral
