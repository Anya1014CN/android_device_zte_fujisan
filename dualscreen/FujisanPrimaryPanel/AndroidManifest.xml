<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zte.fujisan.primarypanel">
    <!-- Keep the custom-tile host's appName non-null in Android 16 QS edit
         mode; use a literal rather than relying on the legacy resource path. -->
    <application android:label="Fujisan Primary Panel">
        <service
            android:name=".PrimaryPanelTileService"
            android:exported="true"
            android:icon="@drawable/ic_primary_panel"
            android:label="Main screen switch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
