<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zte.fujisan.flashlight">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.STATUS_BAR" />

    <!-- SystemUI's Android 16 edit model requires a non-null literal app
         label for every custom tile.  Resource-only labels on this legacy
         privileged APK resolve to null in that path and restart SystemUI. -->
    <application android:label="Fujisan Flashlight">
        <service
            android:name=".FujisanFlashlightTileService"
            android:exported="true"
            android:icon="@drawable/ic_flashlight"
            android:label="Flashlight"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
