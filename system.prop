persist.radio.multisim.config=dsds
persist.radio.VT_ENABLE=1
persist.radio.VT_HYBRID_ENABLE=1
persist.radio.block_allow_data=1
persist.radio.calls.on.ims=true
persist.radio.data_con_rprt=1
persist.radio.domain.ps=false
persist.radio.hw_mbn_update=0
persist.radio.sap_silent_pin=true
persist.radio.schd.cache=3500
persist.radio.signal_on=true
persist.radio.sw_mbn_update=0
persist.radio.trigger.silence=true
persist.radio.videopause.mode=1
persist.radio.vrte_logic=1
persist.vendor.radio.add_power_save=1
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.eons.enabled=false
persist.vendor.radio.msim.stackid_0=0
persist.vendor.radio.msim.stackid_1=1
persist.vendor.radio.rat_on=combine
persist.vendor.radio.ril_payload_on=0
persist.vendor.radio.sglte_target=0
persist.vendor.radio.sib16_support=1
persist.vendor.radio.stack_id_0=0
persist.vendor.radio.stack_id_1=1
ril.subscription.types=NV,RUIM
persist.data.iwlan.enable=true
persist.data.mode=concurrent
bluetooth.enable_timeout_ms=8000
qcom.bluetooth.soc=rome
vendor.qcom.bluetooth.soc=rome
ro.bt.bdaddr_path=/data/vendor/bluetooth/bluetooth_bdaddr
ro.board.platform=msm8996
ro.build.product=fujisan
ro.opengles.version=196610
ro.config.navkeys=0
qemu.hw.mainkeys=0
ro.hardware=qcom
ro.product.device=fujisan
ro.product.model=ZTE Axon M
ro.sf.lcd_density=480
ro.sf.limit_duplicate_layer_numbers=1
ro.telephony.default_network=22,20
ro.use_data_netmgrd=true
ro.qualcomm.bt.hci_transport=uart
wifi.interface=wlan0

debug.gralloc.enable_fb_ubwc=0
debug.gralloc.gfx_ubwc_disable=1
debug.sf.disable_hwc=0
debug.sf.enable_hwc_vds=1
debug.sf.hw=1
debug.sf.latch_unsignaled=1
debug.sf.recomputecrop=0
persist.hwc.enable_vds=1
vendor.display.enable_default_color_mode=1

# Bring-up: keep adb enabled even if userspace restarts early.
persist.sys.usb.config=adb
sys.usb.config=adb
sys.usb.configfs=1
sys.usb.controller=6a00000.dwc3
ro.adb.secure=0


# USB uses configfs on 4.4.

# QTI gatekeeper module for HIDL passthrough service
ro.hardware.gatekeeper=msm8996

# Dual-panel L1 (independent secondary FB / display)
persist.vendor.display.primary_first=1
ro.sf.lcd_density=480

# Use device HWC wrapper for independent panel B (not mirror)
ro.hardware.hwcomposer=fujisan

# Fujisan hinge / dual-LCD posture (stock-compatible semantics)
# hall_status: 1=A closed, 2=B open, 3=C closed(B face)
vendor.fujisan.hall_status=1
vendor.fujisan.device_state=closed_a
vendor.fujisan.display_mode=single
persist.vendor.fujisan.primary_panel=a
persist.vendor.fujisan.primary_force=0
# Default to two independent INTERNAL displays.  A device that already has a
# persisted value keeps it; set this property to 1 once after updating.
persist.vendor.fujisan.dual_internal=1
vendor.fujisan.display_power=1
vendor.fujisan.active_primary=a
ro.feature.target_dual_display=1
