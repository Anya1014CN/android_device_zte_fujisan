// Linux 3.18 does not provide the Android 12 eBPF program/cgroup ABI.
// Replace AOSP bpfloader, which reboots the device when that ABI is absent.
cc_binary {
    name: "fujisan_bpfloader",
    srcs: ["rootdir/bin/fujisan_bpfloader.cpp"],
    stem: "bpfloader",
    overrides: ["bpfloader"],
    init_rc: ["rootdir/etc/init/bpfloader.rc"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libc",
        "libdl",
        "libm",
    ],
}
