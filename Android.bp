// Fujisan is Linux 3.18; gemini/msm8996 is 4.4 with full eBPF.
// Never install over system/bin/bpfloader (dual install rules collide).
// Ship a separate stub and repoint the init service via bpfloader.rc.
cc_binary {
    name: "fujisan_bpfloader",
    srcs: ["rootdir/bin/fujisan_bpfloader.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libc",
        "libdl",
        "libm",
    ],
}
