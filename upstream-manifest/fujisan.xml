<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fujisan's source replacement manifest for LineageOS 19.1.

  repo's standard lineage.dependencies format only fetches projects absent from
  the main manifest; it intentionally never replaces an existing manifest
  project. All four projects already exist in a Lineage checkout, so their
  forks must be selected with this standard local-manifest override. Keeping
  this file next to lineage.dependencies prevents a build from silently mixing
  official and Fujisan source trees.
-->
<manifest>
    <remove-project name="platform/frameworks/base" />
    <project name="Anya1014CN/android_frameworks_base"
             path="frameworks/base"
             remote="github"
             revision="lineage-19.1" />

    <remove-project name="platform/frameworks/native" />
    <project name="Anya1014CN/android_frameworks_native"
             path="frameworks/native"
             remote="github"
             revision="lineage-19.1" />

    <remove-project name="LineageOS/android_packages_apps_Settings" />
    <project name="Anya1014CN/android_packages_apps_Settings"
             path="packages/apps/Settings"
             remote="github"
             revision="lineage-19.1" />

    <remove-project name="LineageOS/android_packages_apps_Trebuchet" />
    <project name="Anya1014CN/android_packages_apps_Trebuchet"
             path="packages/apps/Trebuchet"
             remote="github"
             revision="lineage-19.1" />
</manifest>
