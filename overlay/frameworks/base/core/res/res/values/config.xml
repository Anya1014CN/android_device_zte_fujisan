<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- The imported QTI IMS stack provides MMTEL over LTE. -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_carrier_volte_available">true</bool>

    <!-- The PMI8994 RGB LED is wired through the standard lights HAL. -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!--
      The dual-panel composer does not provide the legacy all-displays-off
      callback that couples autosuspend to display blanking.  Let the AOSP
      power manager drive the existing SystemSuspend service from its normal
      suspend-blocker state instead.
    -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>5</item>
        <item>20</item>
        <item>50</item>
        <item>100</item>
        <item>300</item>
        <item>800</item>
        <item>2000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>3</item>
        <item>8</item>
        <item>20</item>
        <item>40</item>
        <item>70</item>
        <item>110</item>
        <item>160</item>
        <item>220</item>
        <item>255</item>
    </integer-array>

    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">4000</integer>

    <!-- Do not mirror local secondary displays onto default. -->
    <bool name="config_localDisplaysMirrorContent">false</bool>

    <!-- Lid (mxm1120 SW_LID) drives fold posture via DeviceState. -->
    <bool name="config_lidControlsDisplayFold">true</bool>
    <integer-array name="config_foldedDeviceStates">
        <item>0</item>
    </integer-array>
    <integer-array name="config_openDeviceStates">
        <item>1</item>
    </integer-array>
    <integer-array name="config_halfFoldedDeviceStates" />

    <!-- Legacy FPC1020 side fingerprint sensor; the HIDL HAL has no location API. -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>
    <bool name="config_is_powerbutton_fps">true</bool>
    <array name="config_sfps_sensor_props" translatable="false">
        <item>@array/config_fujisan_sfps_sensor_location</item>
    </array>
    <array name="config_fujisan_sfps_sensor_location" translatable="false">
        <item>local:0</item>
        <item>0</item>
        <item>861</item>
        <item>50</item>
    </array>

    <!--
      Single-panel fallback: do not publish a hinge or posture mapping.
      AndroidX WindowManager reports display features to applications even when
      HWC exposes only 1080x1920; the old virtual A+B hinge therefore made
      adaptive layouts select a two-pane/expanded presentation on this phone.
    -->

    <!-- This is a conventional single-display phone; retain the platform
         default multi-window policy instead of advertising large-screen
         freeform capabilities. -->

    <!-- Use the public NTP pool for framework time synchronization. -->
    <string name="config_ntpServer" translatable="false">pool.ntp.org</string>
</resources>
