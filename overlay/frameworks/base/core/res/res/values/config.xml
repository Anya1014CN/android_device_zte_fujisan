<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <bool name="config_automatic_brightness_available">true</bool>


    <!-- The PMI8994 RGB LED is wired through the standard lights HAL. -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>5</item>
        <item>20</item>
        <item>50</item>
        <item>100</item>
        <item>300</item>
        <item>800</item>
        <item>2000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>3</item>
        <item>8</item>
        <item>20</item>
        <item>40</item>
        <item>70</item>
        <item>110</item>
        <item>160</item>
        <item>220</item>
        <item>255</item>
    </integer-array>

    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">4000</integer>

    <!-- Do not mirror local secondary displays onto default. -->
    <bool name="config_localDisplaysMirrorContent">false</bool>

    <!-- Lid (mxm1120 SW_LID) drives fold posture via DeviceState. -->
    <bool name="config_lidControlsDisplayFold">true</bool>
    <integer-array name="config_foldedDeviceStates">
        <item>0</item>
    </integer-array>
    <integer-array name="config_openDeviceStates">
        <item>1</item>
    </integer-array>
    <integer-array name="config_halfFoldedDeviceStates" />

    <!--
      The two 1080x1920 panels form one 2160x1920 logical display when open.
      This is an actual physical gap, not a display cutout.  The WindowManager
      Jetpack extension rotates this natural-orientation rectangle with the
      display, so portrait has a vertical central hinge and landscape has a
      horizontal central hinge.

      State 0 is folded and deliberately maps to UNKNOWN, which suppresses the
      feature while only panel A is active.  State 1 is the opened/flat posture.
    -->
    <string name="config_display_features" translatable="false">hinge-[1079,0,1081,1920]</string>
    <string-array name="config_device_state_postures" translatable="false">
        <item>0:-1</item>
        <item>1:3</item>
    </string-array>

    <!-- The platform already supports split screen; make the large unfolded
         display an always-eligible multi-window and freeform target. -->
    <bool name="config_freeformWindowManagement">true</bool>
    <integer name="config_supportsNonResizableMultiWindow">1</integer>
    <integer name="config_respectsActivityMinWidthHeightMultiWindow">-1</integer>
</resources>
